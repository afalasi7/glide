# Public app origin (success / cancel return URLs). Safe for the client bundle.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3456

# Server-only Stripe secret (test mode). NEVER use NEXT_PUBLIC_ for this key.
# Create a Checkout Session only; no Customers, no setup_future_usage, no saved cards.
STRIPE_SECRET_KEY=sk_test_replace_me

# Webhook signing secret from `stripe listen --forward-to localhost:3456/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_me
