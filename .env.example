# Public app origin (success / cancel return URLs). Safe for the client bundle.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3456

# --- Durable booking store (required BEFORE enabling Stripe) ---
# Vercel Marketplace Upstash Redis / KV. Either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative names from the Vercel KV marketplace integration:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Stripe (test mode) — add only after Upstash is configured ---
# Server-only. NEVER use NEXT_PUBLIC_ for the secret key.
# Checkout refuses to create sessions if Stripe is set without storage (never take money we can't record).
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen --forward-to localhost:3456/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
