# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent scratch & local logs
server.log
server.pid
.claude
.codex
.freebuff
skills-reference
.gstack/

# graphify generated map (build locally with: graphify .)
graphify-out/

# iCloud Drive duplicates ("foo 2.txt" or "foo 2" alongside "foo.txt") — never commit.
# gitignore supports character classes, so cover numbered copies with and without
# an extension. (tsconfig.json globs do NOT support [0-9], which is why it uses
# `**/* *.ts` instead.)
* [0-9]
* [0-9].*
* [0-9][0-9]
* [0-9][0-9].*

# Local / generated
/output/
/tmp/
/.impeccable/
glide-product-summary.html
glide-product-summary.pdf
